<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MainColors">
        <!-- colorPrimarySecond used because colorPrimary fails for no reason in alerts -->
        <attr name="colorPrimarySecond" format="color"/>
        <attr name="colorPrimaryMegaDark" format="color"/>
        <attr name="colorPrimaryDarker" format="color"/>

        <attr name="darkBar" format="color"/>
        <attr name="darkBarLight" format="color"/>
        <attr name="darkBarTransparent" format="color"/>
        <attr name="backgroundLight" format="color"/>

        <attr name="textColor" format="color"/>
        <attr name="textColorGray" format="color"/>
        <attr name="textColorGrayWhite" format="color"/>
        <attr name="white" format="color"/>
        <attr name="video_ripple" format="color"/>

    </declare-styleable>
    <declare-styleable name="FlowLayout_Layout"/>

    <declare-styleable name="ParallaxScroll">
        <attr name="parallax_factor" format="float" />
        <attr name="alpha_factor" format="float" />
        <attr name="inner_parallax_factor" format="float" />
        <attr name="parallax_views_num" format="integer" />
        <attr name="circular_parallax" format="boolean" />
    </declare-styleable>

</resources>